{
  "swaggerDefinition": {
    "openapi": "3.0.0",
    "info": {
      "title": "Book API Documentation",
      "version": "1.0.0",
      "description": "Documentation for Book API with JWT Authentication"
    },
    "servers": [
      {
        "url": "http://localhost:3000/api"
      }
    ],
    "components": {
      "securitySchemes": {
        "bearerAuth": {
          "type": "http",
          "scheme": "bearer",
          "bearerFormat": "JWT",
          "description": "Enter your JWT token in the format: Bearer <token>"
        }
      }
    },
    "security": [
      {
        "bearerAuth": []
      }
    ]
  },
  "apis": ["./routes/**/*.js"]
}