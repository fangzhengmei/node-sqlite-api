# 服务器端口
PORT=3000

# JWT 配置
# 请在生产环境中使用强密钥
JWT_SECRET=your-strong-jwt-secret-key-change-this-in-production

# Access Token 配置（短生命周期，用于 API 访问）
# 建议设置为 15m 或更短时间以提高安全性
ACCESS_TOKEN_EXPIRES_IN=15m

# Refresh Token 配置（长生命周期，用于刷新 Access Token）
# 刷新令牌过期时间（天），决定用户需要多久重新登录一次
REFRESH_TOKEN_EXPIRY_DAYS=7

# 登录安全配置
# 最大登录尝试次数，超过后账户会被锁定
# 建议设置为 3-5 次以防止暴力破解
MAX_LOGIN_ATTEMPTS=5

# 账户锁定时间（分钟）
# 建议设置为 15-60 分钟
LOCK_DURATION_MINUTES=30

# 限流窗口（分钟）
# 防止同一 IP 在短时间内发起大量请求
RATE_LIMIT_WINDOW_MINUTES=15

# 每个窗口内最大登录请求数
# 超过此数量后会被限流
MAX_REQUESTS_PER_WINDOW=100

# 登出时撤销该用户所有 Token
# true: 登出时撤销该用户的所有 refresh token（所有设备都会登出）
# false: 登出时只撤销当前使用的 token
LOGOUT_REVOKE_ALL=false

# 节点环境
NODE_ENV=development
